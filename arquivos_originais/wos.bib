@inproceedings{ WOS:001234855400030,
Author = {Frankford, Eduard and Sauerwein, Clemens and Bassner, Patrick and
   Krusche, Stephan and Breu, Ruth},
Book-Group-Author = {ASSOC COMPUTING MACHINERY},
Title = {AI-Tutoring in Software Engineering Education Experiences with Large
   Language Models in Programming Assessments},
