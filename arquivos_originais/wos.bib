Title = {Using Large Language Models to Develop Requirements Elicitation Skills},
Booktitle = {PROCEEDINGS OF THE 30TH ACM CONFERENCE ON INNOVATION AND TECHNOLOGY IN
   COMPUTER SCIENCE EDUCATION VOL 2, ITICSE 2025},
Year = {2025},
Pages = {774},
Note = {30th Conference on Innovation and Technology in Computer Science
   Education-ITICSE-Annual, Nijmegen, NETHERLANDS, JUN 27-JUL 02, 2025},
Organization = {Association for Computing Machinery; SIGCSE},
Abstract = {Requirements Elicitation (RE) is a crucial software engineering skill
   that involves interviewing a client and then devising a software design
   based on the interview results. We propose conditioning a large language
   model to play the role of the client during a chatbased interview. We
   evaluate our approach in a study (n= 120) using both a qualitative
   survey and quantitative observations about participants' work. Our
   positive findings suggest a new way to practice critical RE skills in a
   scalable and realistic manner without the overhead of arranging live
   interviews.},
