Author = {Yabaku, Mounika and Ouhbi, Sofia},
Editor = {Bollin, A and Bosnic, I and Brings, J and Daun, M and Manjunath, M},
Title = {University Students' Perception and Expectations of Generative AI Tools
   for Software Engineering},
Booktitle = {2024 36TH INTERNATIONAL CONFERENCE ON SOFTWARE ENGINEERING EDUCATION AND
