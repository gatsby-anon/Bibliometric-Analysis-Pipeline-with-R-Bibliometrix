Title = {Learning Agent-based Modeling with LLM Companions: Experiences of
   Novices and Experts Using ChatGPT \& NetLogo Chat},
Booktitle = {PROCEEDINGS OF THE 2024 CHI CONFERENCE ON HUMAN FACTORS IN COMPUTING
   SYTEMS, CHI 2024},
Year = {2024},
