@inproceedings{ WOS:001336361100031,
Author = {Zeng, Guolong and Xue, Qinchen and Lu, Xuesong},
Editor = {Jin, C and Yang, S and Shang, X and Wang, H and Zhang, Y},
Title = {Instruction Tuning with LLMs for Programming Exercise Generation},
