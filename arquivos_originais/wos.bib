@inproceedings{ WOS:001051691300018,
Author = {Daun, Marian and Brings, Jennifer},
Book-Group-Author = {ACM},
Title = {How ChatGPT Will Change Software Engineering Education},
Booktitle = {PROCEEDINGS OF THE 2023 CONFERENCE ON INNOVATION AND TECHNOLOGY IN
   COMPUTER SCIENCE EDUCATION, ITICSE 2023, VOL 1},
Year = {2023},
