@inproceedings{ WOS:001294614500007,
Author = {Yang, Stephanie and Zhao, Hanzhang and Xu, Yudian and Brennan, Karen and
   Schneider, Bertrand},
Book-Group-Author = {Assoc Computing Machinery},
Title = {Debugging with an AI Tutor: Investigating Novice Help-seeking Behaviors
   and Perceived Learning},
Booktitle = {20TH ANNUAL ACM CONFERENCE ON INTERNATIONAL COMPUTING EDUCATION
   RESEARCH, ICER 2024, VOL 1},
Year = {2024},
