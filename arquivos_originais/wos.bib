Title = {Chat Overflow: Artificially Intelligent Models for Computing Education -
   renAIssance or apocAIypse?},
Booktitle = {PROCEEDINGS OF THE 2023 CONFERENCE ON INNOVATION AND TECHNOLOGY IN
   COMPUTER SCIENCE EDUCATION, ITICSE 2023, VOL 1},
