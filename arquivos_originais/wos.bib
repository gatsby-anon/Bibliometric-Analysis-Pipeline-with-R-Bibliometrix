   Education-ITICSE-Annual, Nijmegen, NETHERLANDS, JUN 27-JUL 02, 2025},
Organization = {Association for Computing Machinery; SIGCSE},
Abstract = {LLMs are increasingly used in programming education. However, little
   research has explored their use in teaching and learning code
   refactoring. In this study, we use a grounded-theory approach to examine
   student-LLM conversations during code refactoring exercises. Our
   preliminary results showthat students use LLM in various modes, such as
   requesting a refactoring for the entire program at once or discussing
   refactoring possibilities in long conversations.},
