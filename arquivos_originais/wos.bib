@inproceedings{ WOS:001472310000016,
Author = {Kerslake, Chris and Denny, Paul and Smith, IV, David H. and Prather,
   James and Leinonen, Juho and Luxton-Reilly, Andrew and MacNeil, Stephen},
Book-Group-Author = {ASSOC COMPUTING MACHINERY},
Title = {Integrating Natural Language Prompting Tasks in Introductory Programming
   Courses},
Booktitle = {PROCEEDINGS OF THE 2024 ACM VIRTUAL GLOBAL COMPUTING EDUCATION
   CONFERENCE V.1, SIGCSE VIRTUAL 2024},
Year = {2024},
