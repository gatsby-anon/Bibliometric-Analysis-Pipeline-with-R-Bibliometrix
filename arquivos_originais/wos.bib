@inproceedings{ WOS:001533112700024,
Author = {Draskovic, Drazen},
Book-Group-Author = {IEEE},
Title = {Integration of AI tools into an AI-driven software system to make
   learning programming easier},
Booktitle = {2025 IEEE GLOBAL ENGINEERING EDUCATION CONFERENCE, EDUCON},
