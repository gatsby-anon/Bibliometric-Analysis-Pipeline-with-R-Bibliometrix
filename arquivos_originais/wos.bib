Title = {Equity Issues Derived from Use of Large Language Models in Education},
Booktitle = {NEW MEDIA PEDAGOGY: RESEARCH TRENDS, METHODOLOGICAL CHALLENGES, AND
   SUCCESSFUL IMPLEMENTATIONS, NMP 2023},
