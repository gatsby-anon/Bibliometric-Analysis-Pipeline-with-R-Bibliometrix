@inproceedings{ WOS:001285483900008,
Author = {Lee, Yanggyu and Jeong, Suchae and Kim, Jihie},
Editor = {Sifaleras, A and Lin, F},
Title = {Improving LLM Classification of Logical Errors by Integrating Error
   Relationship into Prompts},
Booktitle = {GENERATIVE INTELLIGENCE AND INTELLIGENT TUTORING SYSTEMS, PT I, ITS 2024},
Series = {Lecture Notes in Computer Science},
