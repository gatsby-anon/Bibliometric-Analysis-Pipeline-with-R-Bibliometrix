@inproceedings{ WOS:001054840400007,
Author = {Wermelinger, Michel},
Book-Group-Author = {ACM},
Title = {Checking Conformance to a Subset of the Python Language},
Booktitle = {PROCEEDINGS OF THE 2023 CONFERENCE ON INNOVATION AND TECHNOLOGY IN
   COMPUTER SCIENCE EDUCATION, ITICSE 2023, VOL. 2},
Year = {2023},
Pages = {573-574},
Note = {28th Annual Conference on Innovation and Technology in Computer Science
   Education (ITiCSE), Univ Turku, Turku, FINLAND, JUL 08-12, 2023},
Organization = {Assoc Comp Machinery; ACM Special Interest Grp Comp Sci Educ; ACM Europe
   Council; Informat Europe},
Abstract = {Introductory courses usually only teach a small subset of a programming
   language and its library, in order to focus on the general concepts
   rather than overwhelm students with the syntactic, semantic and API
   minutiae of a particular language.
   This paper presents courseware that checks if a program only uses the
   subset of the Python language and library defined by the instructor.
   This allows to automatically check that programming examples, exercises
   and assessments only use the taught constructs. It also helps detect
   student code with advanced constructs, possibly copied from Q\&A sites
   or generated by large language models.
   The tool is easy to install, configure and use. It also checks Python
   code in Jupyter notebooks, a popular format for interactive textbooks
   and assessment handouts.},
