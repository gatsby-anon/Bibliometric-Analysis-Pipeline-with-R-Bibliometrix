Title = {Developing a GPT Chatbot Model for Students Programming Education},
Booktitle = {SMART TECHNOLOGIES FOR A SUSTAINABLE FUTURE, VOL 2, STE 2024},
Series = {Lecture Notes in Networks and Systems},
Year = {2024},
