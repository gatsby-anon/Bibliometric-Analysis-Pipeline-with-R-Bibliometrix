@inproceedings{ WOS:001440807300007,
Author = {Sanchez, Mario and Herrera, Andrea},
Editor = {Tabares, M and Vallejo, P and Suarez, B and Suarez, M and Ruiz, O and Aguilar, J},
Title = {Assessing ChatGPT's Proficiency in CS1-Level Problem Solving},
