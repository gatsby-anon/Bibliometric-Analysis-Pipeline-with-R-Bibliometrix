@article{ WOS:001477865400001,
Author = {Wang, Yong and Gu, Xiangdong},
Title = {Predictors of university students' acceptance of ChatGPT in Chinese
   academic context},
Journal = {INNOVATIONS IN EDUCATION AND TEACHING INTERNATIONAL},
Year = {2025},
Month = {2025 APR 28},
Abstract = {The current study examines predictors of university students' acceptance
   of ChatGPT in the Chinese academic context. An online questionnaire
   survey collected 645 valid responses from Chinese university students in
   the academic community. Employing the technology acceptance model as the
   theoretical framework and structural equation modelling approach, this
   research yielded four major findings: (1) Perceived accessibility and
   computational thinking significantly and positively predict perceived
   ease of use; (2) Perceived ease of use, academic grit and computational
   thinking are significant and positive determinants of perceived
   usefulness; (3) Perceived usefulness and perceived ease of use
   collectively exert significant and positive influences on attitude
   towards use; (4) Perceived accessibility, computational thinking and
   attitude towards use exhibit significant and positive impacts on the
   behavioural intention to use. This study may offer a valuable
   understanding of academic researchers and technology designers seeking
   to promote the acceptance of ChatGPT in Chinese academic contexts and
   much broader contexts.},
