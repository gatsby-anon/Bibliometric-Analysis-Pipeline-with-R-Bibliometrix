@inproceedings{ WOS:001234855400001,
Author = {Pan, Wei Hung and Chok, Ming Jie and Wong, Jonathan Leong Shan and Shin,
   Yung Xin and Poon, Yeong Shian and Yang, Zhou and Chong, Chun Yong and
   Lo, David and Lim, Mei Kuan},
Book-Group-Author = {ASSOC COMPUTING MACHINERY},
Title = {Assessing AI Detectors in Identifying AI-Generated Code: Implications
   for Education},
Booktitle = {2024 ACM/IEEE 44TH INTERNATIONAL CONFERENCE ON SOFTWARE ENGINEERING:
   SOFTWARE ENGINEERING EDUCATION AND TRAINING, ICSE-SEET 2024},
Year = {2024},
