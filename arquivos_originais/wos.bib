@inproceedings{ WOS:001265872600019,
Author = {Bernstein, Seth and Denny, Paul and Leinonen, Juho and Kan, Lauren and
   Hellas, Arto and Littlefield, Matt and Sarsa, Sami and MacNeil, Stephen},
Book-Group-Author = {ACM},
Title = {``Like a Nesting Doll{''}: Analyzing Recursion Analogies Generated by CS
   Students Using Large Language Models},
Booktitle = {PROCEEDINGS OF THE 2024 CONFERENCE INNOVATION AND TECHNOLOGY IN COMPUTER
   SCIENCE EDUCATION, VOL 1, ITICSE 2024},
Year = {2024},
