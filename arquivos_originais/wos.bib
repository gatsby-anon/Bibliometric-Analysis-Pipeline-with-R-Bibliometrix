@article{ WOS:001511484600001,
Author = {Tran, Hung Van and Phuong, Loan Vo Thi and Cong, Quyet Nguyen and Tam,
   Nhu Tran Le},
Title = {Which factor most influences the decision of 10th grade students to use
   ChatGPT for programming education? A case study in Da Nang City, Vietnam},
Journal = {INTERACTIVE LEARNING ENVIRONMENTS},
Year = {2025},
Month = {2025 JUN 17},
Abstract = {The application of artificial intelligence (AI) technology, especially
   ChatGPT, is becoming a powerful tool in programming education. ChatGPT
   helps improve programming skills, supports answering questions, provides
   source code examples, and explains programming concepts. It is also a
   valuable resource for self-study and research. However, in Vietnam, the
   implementation and dissemination of ChatGPT in programming education
   still face many challenges. This study aims to identify the factors
   affecting the decision to use ChatGPT of 10th-grade students in
   programming learning, thereby finding the factor with the most
   substantial impact. To achieve the above goal, the authors conducted a
   quantitative survey with 845 10th-grade students at high schools in Da
   Nang City. The collected data were processed using SPSS 24 software and
   analyzed using Structural Equation Modeling (SEM), and the meaning of
   DTU (Decision to Use) was explained. The SEM analysis showed that four
   main factors - support tools, personal capacity, background knowledge,
   and learning environment - positively impacted students' decision to use
   ChatGPT. Personal capacity was the most decisive factor. In contrast,
   the factor of ChatGPT's usefulness did not have a statistically
   significant impact on this decision.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
