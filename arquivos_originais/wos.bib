@article{ WOS:001320552500001,
Author = {Bernardino, Maicon and Cargnelutti, Rodrigo and Garcia, Renato de Souza
   and Silva, Williamson},
Title = {The Use of ChatGPT in Improving and Reviewing Scientific Paper Writing:
   An Exploratory Study},
Journal = {IEEE REVISTA IBEROAMERICANA DE TECNOLOGIAS DEL APRENDIZAJE-IEEE RITA},
Year = {2024},
Volume = {19},
Pages = {120-128},
Abstract = {Software Engineering students enrolled in the Problem Solving I (PSI)
   course experience a Requirements Engineering (RE) approach to education.
   As part of one of the PSI assessments, students must develop a
   manuscript on RE. Following submission and presentation, we conducted an
   exploratory study to assess students' perception of using ChatGPT to
   support improving and reviewing their scientific paper writing. Based on
   the results obtained from the participants (n = 40), we highlight the
   different ways to use ChatGPT to support the learning process. We
   conclude that ChatGPT and other AI tools can and should be explored by
   students and professors in the academic setting. However, evaluating the
   generated responses with caution and discernment is essential. Moreover,
   to enhance the overall experience, it is crucial to pose precise
   questions that yield accurate responses; this, in essence, constitutes
   the primary challenge.},
