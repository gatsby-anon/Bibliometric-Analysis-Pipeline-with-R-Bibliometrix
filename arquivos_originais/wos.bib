@inproceedings{ WOS:001472310000008,
Author = {Golesteanu, Matei A. and Vowinkel, Garrett B. and Dougherty, Ryan E.},
Book-Group-Author = {ASSOC COMPUTING MACHINERY},
Title = {Can ChatGPT Pass a Theory of Computing Course?},
Booktitle = {PROCEEDINGS OF THE 2024 ACM VIRTUAL GLOBAL COMPUTING EDUCATION
   CONFERENCE V.1, SIGCSE VIRTUAL 2024},
Year = {2024},
Pages = {33-38},
Note = {1st ACM Virtual Global Computing Education Conference (SIGCSE), ELECTR
   NETWORK, DEC 05-08, 2024},
Organization = {ACM; ACM SIGCSE},
Abstract = {Large Language Models (LLMs) have had considerable difficulty when
   prompted with mathematical and formal questions, especially those within
   theory of computing (ToC) courses. In this paper, we detail two
   experiments regarding our own ToC course and the ChatGPT LLM. For the
   first, we evaluated ChatGPT's ability to pass our own ToC course's
   exams. For the second, we created a database of sample ToC questions and
   responses to accommodate other ToC offerings' choices for topics and
   structure. We scored each of ChatGPT's outputs on these questions.
   Overall, we determined that ChatGPTcan pass our ToC course, and is
   adequate at understanding common formal definitions and answering
   ``simple{''}-style questions, e.g., true/false and multiple choice.
   However, ChatGPT often makes nonsensical claims in open-ended responses,
   such as proofs.},
