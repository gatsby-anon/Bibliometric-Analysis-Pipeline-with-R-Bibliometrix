Title = {Experiences from Using Code Explanations Generated by Large Language
   Models in a Web Software Development E-Book},
Booktitle = {PROCEEDINGS OF THE 54TH ACM TECHNICAL SYMPOSIUM ON COMPUTER SCIENCE
   EDUCATION, VOL 1, SIGCSE 2023},
Year = {2023},
Pages = {931-937},
