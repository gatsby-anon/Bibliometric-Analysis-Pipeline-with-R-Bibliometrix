@inproceedings{ WOS:001533112700359,
Author = {Soll, Marcus and Kobras, Louis},
Book-Group-Author = {IEEE},
Title = {Do Large Language Models Require Prior Knowledge for Learning? A
   Preliminary Study},
Booktitle = {2025 IEEE GLOBAL ENGINEERING EDUCATION CONFERENCE, EDUCON},
Series = {IEEE Global Engineering Education Conference},
Year = {2025},
Note = {16th Global Engineering Education Conference-EDUCON-Annual, London,
   ENGLAND, APR 22-25, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {LLMs find increasing use as an educational tool, both from the
   instructors' perspective as well as from the students'. This paper
   presents a preliminary study investigating the effects of prior
   knowledge concerning a given topic on the effectiveness of using an LLM
   (Microsoft Copilot) to study the topic. Choosing Buchi automata as an
   example, twelve computer science students were tasked with first giving
   a self-report on prior knowledge, then studying Buchi automata for 15
   minutes using only an LLM as a study tool, and afterwards filling out a
   short topical questionnaire. Two trends could be observed: Prior
   knowledge of LLMs seems to increase the learning effect while prior
   knowledge of a topic that is related to the studied topic seems to
   diminish the learning effect.},
Publisher = {IEEE},
Address = {345 E 47TH ST, NEW YORK, NY 10017 USA},
Type = {Proceedings Paper},
