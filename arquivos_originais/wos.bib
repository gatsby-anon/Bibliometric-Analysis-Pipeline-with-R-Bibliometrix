@inproceedings{ WOS:001234855400016,
Author = {Cipriano, Bruno Pereira and Alves, Pedro},
Book-Group-Author = {ASSOC COMPUTING MACHINERY},
Title = {LLMs Still Can't Avoid Instanceof: An Investigation Into GPT-3.5, GPT-4
   and Bard's Capacity to Handle Object-Oriented Programming Assignments},
Booktitle = {2024 ACM/IEEE 44TH INTERNATIONAL CONFERENCE ON SOFTWARE ENGINEERING:
   SOFTWARE ENGINEERING EDUCATION AND TRAINING, ICSE-SEET 2024},
Year = {2024},
Pages = {162-169},
