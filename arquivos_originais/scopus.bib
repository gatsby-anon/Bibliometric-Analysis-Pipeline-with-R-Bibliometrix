@CONFERENCE{Bellettini202359,
	author = {Bellettini, Carlo and Lodi, Michael and Lonati, Violetta and Monga, Mattia and Morpurgo, Anna},
	title = {Davinci Goes to Bebras: A Study on the Problem Solving Ability of GPT-3},
	year = {2023},
	journal = {International Conference on Computer Supported Education, CSEDU - Proceedings},
	volume = {2},
	pages = {59 - 69},
	doi = {10.5220/0012007500003470},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85160866835&doi=10.5220%2F0012007500003470&partnerID=40&md5=bb47ab2c819a88c75a1eaa9bbe63e3b9},
	affiliations = {Università degli Studi di Milano, Milan, Italy; Alma Mater Studiorum Università di Bologna, Bologna, Italy; Laboratorio Nazionale CINI ‘Informatica e Scuola’, Rome, Italy},
	abstract = {In this paper we study the problem-solving ability of the Large Language Model known as GPT-3 (codename DaVinci), by considering its performance in solving tasks proposed in the “Bebras International Challenge on Informatics and Computational Thinking”. In our experiment, GPT-3 was able to answer with a majority of correct answers about one third of the Bebras tasks we submitted to it. The linguistic fluency of GPT-3 is impressive and, at a first reading, its explanations sound coherent, on-topic and authoritative; however the answers it produced are in fact erratic and the explanations often questionable or plainly wrong. The tasks in which the system performs better are those that describe a procedure, asking to execute it on a specific instance of the problem. Tasks solvable with simple, one-step deductive reasoning are more likely to obtain better answers and explanations. Synthesis tasks, or tasks that require a more complex logical consistency get the most incorrect answers. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Bebras; Computer Science Education; GPT-3; Large Language Models},
