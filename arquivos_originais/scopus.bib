@CONFERENCE{Kerslake202488,
	author = {Kerslake, Chris and Denny, Paul C. and Smith, David H. and Prather, James and Leinonen, Juho and Luxton-Reilly, Andrew and MacNeil, Stephen Michael},
	title = {Integrating Natural Language Prompting Tasks in Introductory Programming Courses},
	year = {2024},
	pages = {88 - 94},
	doi = {10.1145/3649165.3690125},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85214749540&doi=10.1145%2F3649165.3690125&partnerID=40&md5=c2498e21fd66fa3a96e3075abd7cf756},
	affiliations = {Simon Fraser University, Burnaby, Canada; The University of Auckland, Auckland, New Zealand; University of Illinois Urbana-Champaign, Urbana, United States; Abilene Christian University, Abilene, United States; Aalto University, Espoo, Finland; Temple University, Philadelphia, United States},
	abstract = {Introductory programming courses often emphasize mastering syntax and basic constructs before progressing to more complex and interesting programs. This bottom-up approach can be frustrating for novices, shifting the focus away from problem solving and potentially making computing less appealing to a broad range of students. The rise of generative AI for code production could partially address these issues by fostering new skills via interaction with AI models, including constructing high-level prompts and evaluating code that is automatically generated. In this experience report, we explore the inclusion of two prompt-focused activities in an introductory course, implemented across four labs in a six-week module. The first requires students to solve computational problems by writing natural language prompts, emphasizing problem-solving over syntax. The second involves students crafting prompts to generate code equivalent to provided fragments, to foster an understanding of the relationship between prompts and code. Most of the students in the course had reported finding programming difficult to learn, often citing frustrations with syntax and debugging. We found that self-reported difficulty with learning programming had a strong inverse relationship with performance on traditional programming assessments such as tests and projects, as expected. However, performance on the natural language tasks was less strongly related to self-reported difficulty, suggesting they may target different skills. Learning how to communicate with AI coding models is becoming an important skill, and natural language prompting tasks may appeal to a broad range of students. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {cs1; eipe; explain in plain english; introductory programming; llm; natural language prompting; prompt engineering},
	keywords = {BASIC (programming language); Computer debugging; Curricula; Inverse problems; Problem oriented languages; Program debugging; Syntactics; Teaching; Cs1; Eipe; Explain in plain english; Introductory programming; Introductory programming course; Llm; Natural language prompting; Natural languages; Problem-solving; Prompt engineering; Students},
	publisher = {Association for Computing Machinery, Inc},
	isbn = {9798400705984},
	language = {English},
	abbrev_source_title = {SIGCSE Virtual - Proc. ACM Virtual Global Comput. Educ. Conf. V. 1},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
