@CONFERENCE{Fan202575,
	author = {Fan, Zhiyu and Noller, Yannic and Dandekar, Ashish and Roychoudhury, Abhik},
	title = {Software Engineering Educational Experience in Building an Intelligent Tutoring System},
	year = {2025},
	journal = {Software Engineering Education Conference, Proceedings},
	pages = {75 - 86},
	doi = {10.1109/CSEET66350.2025.00015},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105008488869&doi=10.1109%2FCSEET66350.2025.00015&partnerID=40&md5=04cd0d84be1e1a06ca69e7227142091f},
	affiliations = {National University of Singapore, Singapore City, Singapore; Ruhr-Universitat Bochum, Bochum, Germany},
	abstract = {The growing number of students enrolling in Computer Science (CS) programmes is pushing CS educators to their limits. This poses significant challenges to computing education, particularly the teaching of introductory programming and advanced software engineering (SE) courses. First-year programming courses often face overwhelming enrollments, including interdisciplinary students who are not CS majors. The high teacher-to-student ratio makes it challenging to provide timely and highquality feedback. Meanwhile, software engineering education comes with inherent difficulties like acquiring industry partners and the dilemma that such software projects are often under or over-specified and one-time efforts within one team or one course. To address these challenges, we designed a novel foundational SE course. This SE course envisions building a full-fledged Intelligent Tutoring System (ITS) of Programming Assignments to provide automated, real-time feedback for novice students in programming courses over multiple years. Each year, SE students contribute to specific short-running SE projects that improve the existing ITS implementation, while at the same time, we can deploy the ITS for usage by students for learning programming. This project setup builds awareness among SE students about their contribution to a 'to-be-deployed' software project. In this multi-year teaching effort, we have incrementally built an ITS that is now deployed in various programming courses. This paper discusses the Intelligent Tutoring System architecture, our teaching concept in the SE course, our experience with the built ITS, and our view of future computing education. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {automated program repair; computer science education; CS-1; intelligent tutoring; large language models; software engineering},
	keywords = {Computer aided instruction; Computer software; Computer systems programming; Curricula; Education computing; Engineering education; Intelligent systems; Teaching; Automated program repair; Computer Science 1; Computer Science Education; Computing education; Intelligent tutoring; Language model; Large language model; Programming course; Software engineering course; Tutoring system; Students},
