	doi = {10.1007/978-3-031-78255-8_21},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85211787233&doi=10.1007%2F978-3-031-78255-8_21&partnerID=40&md5=1a247516803b168188eb2583bd09a695},
	affiliations = {University of Pretoria, Department of Informatics, Pretoria, South Africa},
	abstract = {Generative Artificial Intelligence (GenAI) tools have gained popularity in Higher Education Institutions (HEIs), and tools such as ChatGPT have been reported to impact students’ cognitive thinking skills. This study addresses a gap in the literature regarding the effect of GenAI on the cognitive thinking skills of students and scholars in HEIs. A Systematic Literature Review (SLR) was conducted that yielded relevant research articles, on which a thematic analysis was performed. Cognitive thinking skills identified in the articles include critical thinking, creative thinking, reflective thinking, computational thinking and problem-solving. The study summarised teaching interventions reported in the various studies, which aimed to engage with and enhance cognitive thinking skills. The findings revealed positive and negative impacts of GenAI on cognitive thinking skills. The findings indicated that GenAI such as ChatGPT can help improve, boost, and develop cognitive thinking skills and enhance learning and the overall higher education experience under well-planned guidance. The study subsequently provides guidelines on how students and scholars can use GenAI to improve cognitive thinking skills in HEIs. HEIs are encouraged to create special programs to teach students how to correctly use GenAI tools like ChatGPT. It is worth noting that students need to use their knowledge, thinking skills, and good judgment to use GenAI properly. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Cognitive Thinking; Computational Thinking; Creative Thinking; Critical Thinking; Generative AI; Higher Education Institutions; Problem Solving; Reflective Thinking},
