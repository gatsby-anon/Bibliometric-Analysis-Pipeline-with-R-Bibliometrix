	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Gold Open Access}
}

@ARTICLE{Garcia20256455,
	author = {Garcia, Manuel B.},
	title = {Profiling the skill mastery of introductory programming students: A cognitive diagnostic modeling approach},
	year = {2025},
	journal = {Education and Information Technologies},
	volume = {30},
	number = {5},
	pages = {6455 - 6481},
	doi = {10.1007/s10639-024-13039-6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001930540&doi=10.1007%2Fs10639-024-13039-6&partnerID=40&md5=19c1a5474ef3e4be2caa308acdfe4822},
	affiliations = {University of the Philippines Diliman, College of Education, Quezon City, Philippines; FEU Institute of Technology, Educational Innovation and Technology Hub, Manila, Philippines; Korea University, College of Education, Seoul, South Korea},
	abstract = {The global shortage of skilled programmers remains a persistent challenge. High dropout rates in introductory programming courses pose a significant obstacle to graduation. Previous studies highlighted learning difficulties in programming students, but their specific weaknesses remained unclear. This gap exists due to the predominant focus on the overall academic performance evaluation. To address this gap, this study employed cognitive diagnostic modeling (CDM) to profile the skill mastery of programming students. An empirical analysis was conducted to select the most appropriate model for the data, and the linear logistic model (LLM) was determined to be the best fit. Final examination results from 308 information technology (IT) and 279 computer science (CS) students were analyzed using the LLM. Unfortunately, findings revealed that programming students exhibited proficiency primarily in code tracing and language proficiency but displayed deficits in theoretical understanding, logical reasoning, and algorithmic thinking. From a practical standpoint, this deficiency in fundamental skills sheds light on the factors contributing to academic failures and potentially eventual dropout in programming education. When comparing the student population by academic program, CS students demonstrated superior mastery compared to their IT counterparts, although both groups exhibited a lack of mastery in code tracing. These deviations underscore the pressing need for tailored educational strategies that address the unique strengths and weaknesses of each student group. Overall, this study offers valuable insights into programming education literature and contributes to the expanding application of CDM in educational research. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Cognitive diagnostic modeling; Computer science; Educational assessment; Information technology; Programming education},
