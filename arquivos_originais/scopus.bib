@ARTICLE{Oprea202587292,
	author = {Oprea, Simona Vasilica and Bâra, Adela},
	title = {Transforming Education With Large Language Models: Trends, Themes, and Untapped Potential},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {87292 - 87312},
	doi = {10.1109/ACCESS.2025.3570649},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105005291625&doi=10.1109%2FACCESS.2025.3570649&partnerID=40&md5=25b33332542df1fb6e043838272c36fe},
	affiliations = {Bucharest University of Economic Studies, Department of Economic Informatics and Cybernetics, Bucharest, Romania},
	abstract = {Our research focuses on the transformative intersection of Large Language Models (LLMs) and education in the last six years (2019–2024), examining their potential to modernize educational systems and enhance learning outcomes. Leveraging a comprehensive methodological framework, we analyzed 9,598 publications from Web of Science (WoS), extracting 25,381 education-related terms and mapping academic trends across diverse research areas. Educational research involving LLMs focuses heavily on learning, research and training, with terms such as “education” (1546), “learning” (4828), “research” (4438) and “training” (327) frequently appearing in the analyzed dataset. Specific applications such as grading (121) and tutoring (82) are less emphasized, presenting potential areas for further exploration. Key elements include annual publication patterns, institutional collaborations, citation dynamics and keyword co-occurrence maps. Advanced topic modeling techniques, such as LDA, LDA-BERT and BERT-Clustering, reveal a spectrum of themes, from foundational AI concepts in education to domain-specific applications in fields like legal and financial contexts. The findings highlight major educational themes such as “AI in education”, “medical education” and “programming education”, alongside subfields like “computer science education” and “software engineering education” underscoring a strong focus on technology-driven learning. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {artificial intelligence; education; Large language models; topic modeling},
	keywords = {Active learning; Application programs; Cluster analysis; Curricula; Engineering education; Engineering research; Mapping; Medical computing; Medical education; Personnel training; Search engines; Software design; STEM (science, technology, engineering and mathematics); Students; Educational systems; Enhance learning; Language education; Language model; Large language model; Learning outcome; Methodological frameworks; Research focus; System learning; Topic Modeling; Teaching},
