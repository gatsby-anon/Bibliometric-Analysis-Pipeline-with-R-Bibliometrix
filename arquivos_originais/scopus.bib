@CONFERENCE{Demirtaş20251435,
	author = {Demirtaş, Mehmet Arif and Zheng, Claire and Cunningham, Kathryn},
	title = {Detecting Programming Plans in Open-ended Code Submissions},
	year = {2025},
	volume = {2},
	pages = {1435 - 1436},
	doi = {10.1145/3641555.3705166},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-86000243309&doi=10.1145%2F3641555.3705166&partnerID=40&md5=8fe5967f3f89322823477ddd8ffd5694},
	affiliations = {University of Illinois Urbana-Champaign, Urbana, United States},
	abstract = {Open-ended code-writing exercises are commonly used in large-scale introductory programming courses, as they can be autograded against test cases. However, code writing requires many skills at once, from planning out a solution to applying the intricacies of syntax. As autograding only evaluates code correctness, feedback addressing each of these skills separately cannot be provided. In this work, we explore methods to detect which high-level patterns (i.e. programming plans) have been used in a submission, so learners can receive feedback on planning skills even when their code is not completely correct. Our preliminary results show that LLMs with few-shot prompting can detect the use of programming plans in 95% of correct and 86% of partially correct submissions. Incorporating LLMs into grading of open-ended programming exercises can enable more fine-grained feedback to students, even in cases where their code does not compile due to other errors. © 2025 Elsevier B.V., All rights reserved.},
