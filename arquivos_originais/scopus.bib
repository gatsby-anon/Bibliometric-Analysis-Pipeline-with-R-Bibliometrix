@CONFERENCE{Nath2024,
	author = {Nath, Sagnik and Yoon, So Yoon},
	title = {WIP: Beyond Code: Evaluating ChatGPT, Gemini, Claude, and Meta AI as AI Tutors in Computer Science and Engineering Education},
