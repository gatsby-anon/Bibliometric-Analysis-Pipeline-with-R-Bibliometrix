@ARTICLE{Wan20241745,
	author = {Wan, Han and Luo, Hongzhen and Li, Mengying and Luo, Xiaoyan},
	title = {Automated Program Repair for Introductory Programming Assignments},
	year = {2024},
	journal = {IEEE Transactions on Learning Technologies},
