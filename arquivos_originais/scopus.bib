@ARTICLE{Tuparova20251448,
	author = {Tuparova, Elena and Tuparova, Daniela and Tuparov, Georgi},
	title = {Exploring the Role of Large Language Models in Advancing Student Assessment in Database Courses},
	year = {2025},
	pages = {1448 - 1453},
	doi = {10.1109/MIPRO65660.2025.11131984},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016605376&doi=10.1109%2FMIPRO65660.2025.11131984&partnerID=40&md5=8c05aa31b90e1155fcfa186e306086e3},
	affiliations = {Sofia University St. Kliment Ohridski, Sofia, Bulgaria; South-West University Neofit Rilski, Blagoevgrad, Bulgaria; New Bulgarian University, Sofia, Bulgaria},
	abstract = {Database courses are a fundamental element in computer science education. Performing effective student assessment in them is an essential aspect which often faces various challenges. Some of them include time-intensive preparation of complex and diverse tasks, as well as their subsequent grading. The study presented in this paper focuses on exploring the potential of large language models (LLMs) to support the assessment procedures in university database courses. The key aspects examined in the study are the capabilities of LLMs to create more variety in training and exam tasks and to aid in automatic grading of SQL queries. Along with the benefits of the suggested approach, some limitations are discussed. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {AI in education; computer science education; databases; large language models (LLMs); SQL; student assessment},
