@CONFERENCE{Koutcheme2025,
	author = {Koutcheme, Charles and Dainese, Nicola and Hellas, Arto},
	title = {Reinforcement Learning for Programming Feedback: Aligning Small Language Models Without Human Preferences},
	year = {2025},
	journal = {CEUR Workshop Proceedings},
	volume = {4019},
	pages = {},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105017110829&partnerID=40&md5=462083513992015ff75d9de24266203b},
	affiliations = {Aalto University, Espoo, Finland},
	abstract = {Providing students with timely and effective feedback remains a critical challenge in programming education. Locally deployed Small Language Models (SLMs) offer a cost-effective solution that enables educators to generate feedback while avoiding third-party reliance and privacy concerns associated with Large Language Models (LLMs). However, SLMs often produce misleading or inaccurate feedback, limiting their practical use. This paper presents a fully automated reinforcement learning framework for aligning SLMs to generate high-quality programming feedback without any human-labelled examples or preference annotations. Our approach transfers the feedback capabilities of powerful LLMs (“teacher models”) to smaller, low-resource models (“student models”) that can run locally on consumer hardware, with the optional assistance of medium-sized “assistant” models. The framework supports two configurations: an off-policy setup that uses assistant model generations to bootstrap alignment and a lightweight online on-policy variant that trains directly on student model outputs. We evaluate both approaches by fine-tuning two SLMs on a real-world dataset of CS1 programming submissions collected across semesters. Our experiments simulate realistic deployment scenarios, training on data from past semesters and evaluating on future ones. Results show that both methods significantly improve feedback quality and generalize across new course offerings. We provide practical considerations for aligning SLMs in educational settings and outline a promising direction for future work. Our code is made available on GitHub. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Computing Education; Language Models; Programming Feedback; Reinforcement Learning},
	keywords = {Curricula; Education computing; Feedback; Students; Teaching; Computing education; Cost-effective solutions; Critical challenges; Language model; Privacy concerns; Programming education; Programming feedback; Reinforcement learnings; Student Modeling; Third parties; Cost effectiveness},
	correspondence_address = {C. Koutcheme; Aalto University, Espoo, Finland; email: charles.koutcheme@aalto.fi},
	editor = {Akram, B. and Shi, Y. and Brusilovsky, P. and Price, T. and Koedinger, K. and Carvalho, P. and Zhang, S. and Lan, A. and Leinonen, J.},
	publisher = {CEUR-WS},
