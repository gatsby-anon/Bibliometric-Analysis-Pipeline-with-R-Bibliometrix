@ARTICLE{Rebollido2024582,
	author = {Rebollido, Frances Ysabelle and Caro, Jaime D.L.},
	title = {Code Comprehension Problems in Introductory Programming to Overcome ChatGPT},
	year = {2024},
	journal = {Lecture Notes in Networks and Systems},
	volume = {1170 LNNS},
	pages = {582 - 593},
	doi = {10.1007/978-3-031-73344-4_50},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85207574344&doi=10.1007%2F978-3-031-73344-4_50&partnerID=40&md5=c5816e6da8782dd4a6934dd92ff5f26c},
	affiliations = {University of the Philippines Diliman, Quezon City, Philippines},
	abstract = {The prevalence of Generative AI (GenAI) technologies like ChatGPT necessitates a transformation in introductory programming education. This change shifts the focus to developing critical thinking among students instead of just learning a programming language. Therefore, this study introduces the Code Comprehension Problem (CCP) approach, incorporating value tracing, code correction, and modification exercises to enhance critical thinking and reduce dependence on ChatGPT. This research also assessed the performance of GPT-3.5 and GPT-4 on CCPs, comparing the effectiveness of full-task descriptions versus individual subquestions as prompts. Our analysis revealed that while ChatGPT can address CCPs with variable accuracy, presenting subquestions individually tends to elicit more precise responses. However, we argue that without more advanced prompting techniques, the answers generated by ChatGPT are not suitable for beginners due to the tendency of these models to use more advanced syntax and objects. These findings underscore the need for instructional strategies that not only leverage AI’s potential but also cultivate students’ autonomous problem-solving abilities, preparing them for a future where AI is an integral part of the learning and problem-solving process. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial Intelligence; Assessment; ChatGPT; Education; Programming},
	keywords = {AI Technologies; Assessment; ChatGPT; Code comprehension; Code correction; Code modifications; Critical thinking; Introductory programming; Programming; Programming education; Students},
