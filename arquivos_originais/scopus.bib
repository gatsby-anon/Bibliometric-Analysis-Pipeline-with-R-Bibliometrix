@CONFERENCE{Zi20251479,
	author = {Zi, Yangtian and Li, Luisa and Guha, Arjun and Anderson, Carolyn Jane and Feldman, Molly Q.},
	title = {“I Would Have Written My Code Differently”: Beginners Struggle to Understand LLM-Generated Code},
	year = {2025},
	journal = {Proceedings of the ACM SIGSOFT Symposium on the Foundations of Software Engineering},
	pages = {1479 - 1488},
	doi = {10.1145/3696630.3731663},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013960517&doi=10.1145%2F3696630.3731663&partnerID=40&md5=458e1b3bd3ac2635337fe60121b55310},
	affiliations = {Northeastern University, Boston, United States; Wellesley College, Wellesley, United States; Oberlin College and Conservatory, Oberlin, United States},
	abstract = {Large language models (LLMs) are being increasingly adopted for programming work. Prior work shows that while LLMs accelerate task completion for professional programmers, beginning programmers struggle to prompt models effectively. However, prompting is just half of the code generation process- when code is generated, it must be read, evaluated, and integrated (or rejected). How accessible are these tasks for beginning programmers? This paper measures how well beginners comprehend LLM-generated code and explores the challenges students face in judging code correctness. We compare how well students understand natural language descriptions of functions and LLM-generated implementations, studying 32 CS1 students on 160 task instances. Our results show a low per-task success rate of 32.5%, with indiscriminate struggles across demographic populations. Key challenges include barriers for non-native English speakers, unfamiliarity with Python syntax, and automation bias. Our findings highlight the barrier that code comprehension presents to beginning programmers seeking to write code with LLMs. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Code Comprehension; Computer Science Education; CS1; Large Language Models},
	keywords = {Computational linguistics; Computer programming languages; Education computing; Engineering education; Natural language processing systems; Students; Code comprehension; Codegeneration; Computer Science Education; Generation process; Language description; Language model; Large language model; Natural languages; Professional programmers; Task instance; Codes (symbols)},
