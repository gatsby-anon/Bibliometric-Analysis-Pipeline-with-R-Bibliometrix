	keywords = {Artificial intelligence; Computer systems programming; Curricula; Data privacy; Data reliability; Digital libraries; Education computing; Engineering education; Personnel training; Reviews; Artificial intelligence generated content; Challenge of artificial intelligence generated content; ChatGPT; Data security risks; Key Issues; Language model; Large language model; Programming curriculum; Systematic literature review; Web of Science; Risk assessment},
