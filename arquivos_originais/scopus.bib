@ARTICLE{Miranda20252291,
	author = {Miranda, John Paul P. and Yambao, Jaymark A.},
	title = {Assessing novice programmers’ perception of ChatGPT: performance, risk, decision-making, and intentions},
	year = {2025},
	journal = {Journal of Education and Learning},
	volume = {19},
	number = {4},
	pages = {2291 - 2301},
	doi = {10.11591/edulearn.v19i4.22328},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013810994&doi=10.11591%2Fedulearn.v19i4.22328&partnerID=40&md5=f8d84a81fdeb607f56f867a3e9f63781},
	affiliations = {Pampanga State University, College of Computing Studies, Bacolor, Philippines},
	abstract = {This study explores the novice programmers’ intention to use chat generative pretrained transformer (ChatGPT) for programming tasks with emphasis on performance expectancy (PE), risk-reward appraisal (RRA), and decision-making (DM). Utilizing partial least squares structural equation modeling (PLS-SEM) and a sample of 413 novice programmers, the analysis demonstrates that higher PE of ChatGPT is positively correlated with improved DM in programming tasks. Novice programmers view ChatGPT as a tool that enhances their learning and skill development. Additionally, novice programmers that have a favorable RRA of ChatGPT tend to make more confident and effective decisions, acknowledging potential risks but recognizing that benefits such as quick problem-solving and learning new techniques outweigh these risks. Moreover, a positive perception of ChatGPT’s role in DM significantly increases the inclination to use the tool for programming tasks. These results highlight the critical roles of perceived capabilities, risk assessment, and positive DM experiences in promoting the adoption of artificial intelligence (AI) tools in programming education. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {AI in education; Digital skill development; Educational technology; Innovative learning tools; Programming students},
