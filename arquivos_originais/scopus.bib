@ARTICLE{Azaiz202557,
	author = {Azaiz, Imen and Kiesler, Natalie and Strickroth, Sven and Zhang, Anni},
	title = {Open, Small, Rigmarole – Evaluating Llama 3.2 3B’s Feedback for Programming Exercises},
	year = {2025},
	journal = {International Journal of Engineering Pedagogy},
	volume = {15},
	number = {5},
	pages = {57 - 73},
	doi = {10.3991/ijep.v15i5.55359},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012195520&doi=10.3991%2Fijep.v15i5.55359&partnerID=40&md5=8a2c29de4fae6673982f040cea68587e},
	affiliations = {Ludwig-Maximilians-Universität München, Munich, Germany; Nuremberg Tech, Nuremberg, Germany},
	abstract = {Large Language Models (LLMs) have been subject to extensive research in the past few years. This is particularly true for the potential of LLMs to generate formative programming feedback for novice learners at university. In contrast to Generative AI (GenAI) tools based on LLMs, such as GPT, smaller and open models have received much less attention. Yet, they offer several benefits, as educators can let them run on a virtual machine or personal computer. This can help circumvent some major concerns applicable to other GenAI tools and LLMs (e.g., data protection, lack of control over changes, privacy). Therefore, this study explores the feedback characteristics of the open, lightweight LLM Llama 3.2 (3B). In particular, we investigate the models’ responses to authentic student solutions to introductory programming exercises written in Java. The generated output is qualitatively analyzed to help evaluate the feedback’s quality, content, structure, and other features. The results provide a comprehensive overview of the feedback capabilities and serious shortcomings of this open, small LLM. We further discuss the findings in the context of previous research on LLMs and contribute to benchmarking recently available GenAI tools and their feedback for novice learners of programming. Thereby, this work has implications for educators, learners, and tool developers attempting to utilize all variants of LLMs (including open and small models) to generate formative feedback and support learning. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {benchmark; GenAI; Generative AI; introductory programming; llama; open models; personalized feedback; small language models},
	correspondence_address = {S. Strickroth; Institute for Informatics of Ludwig-Maximilians-Universität München, München, Oettingenstraße 67, 80538, Germany; email: sven.strickroth@ifi.lmu.de},
	publisher = {International Federation of Engineering Education Societies (IFEES)},
