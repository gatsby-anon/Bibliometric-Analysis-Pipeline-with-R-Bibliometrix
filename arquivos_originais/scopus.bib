	year = {2023},
	pages = {1670 - 1676},
	doi = {10.1109/CSCI62032.2023.00276},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199989596&doi=10.1109%2FCSCI62032.2023.00276&partnerID=40&md5=c1e5918cae11a1afe83613432a150d9a},
	affiliations = {Boston College, Department of Computer Science, Chestnut Hill, United States},
	abstract = {Introductory Computer Science (CS) programs at higher education institutions include a variety of introductory courses commonly known as CS1 and CS2; some institutions offer additional variations (e.g., CS0, CS1.5). Accurate placement of students in these courses is vital for students' success. This paper introduces a machine learning-based CS placement test system using LLMs and classifiers, incorporating a concept inventory (CI) assessment. Five LLMs were evaluated, and the best one was chosen to generate questions. The questions were stored in a database, allowing customized placement tests through an interactive assessment system. After the test, students' performance data were used to train three simple MLP classifiers, achieving over 83% accuracy in a case study with 46 participants. © 2024 Elsevier B.V., All rights reserved.},
