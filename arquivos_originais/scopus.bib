@CONFERENCE{Jégourel2024,
	author = {Jégourel, Cyrille and Ong, Jung Yi and Kurniawan, Oka and Shin, Lim Meng and Chitluru, Kushat},
	title = {Sieving Coding Assignments Over Submissions Generated by AI and Novice Programmers},
	year = {2024},
	pages = {},
	doi = {10.1145/3699538.3699569},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215512667&doi=10.1145%2F3699538.3699569&partnerID=40&md5=e9481f0702ffa9a344cd2ca3f2b9322f},
	affiliations = {Singapore University of Technology and Design, Singapore City, France; Singapore University of Technology and Design, Singapore City, Singapore; Singapore University of Technology and Design, Singapore City, Indonesia; Dunman High School, Singapore City, Singapore; Temasek Junior College, Singapore City, Singapore},
	abstract = {In the era of AI tools like ChatGPT and GitHub Copilot, and with the numerous online resources, computer science education faces the challenge of students potentially submitting plagiarised coding assignments or assignments generated by these technologies. Distinguishing between AI-generated and human-written text is notoriously difficult. In this study, we applied two text distance algorithms, commonly used for machine translation and document comparisons, to detect similarities between various computer Python code submissions and employed hierarchical clustering to analyze them from both AI tools and human programmers. Our results indicate that the distances to the cluster representatives can effectively predict whether a code submission is generated by AI or by novice programmers, achieving an accuracy of over 90%. These findings demonstrate the significant potential of text distance algorithms in identifying the origin of coding submissions, whether generated by AI or by novice programmers. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {AI code generation; code clone detection; code distance; Computing education; hierarchical clustering; plagiarism},
	keywords = {Distance education; Machine translation; Students; AI code generation; Code clone detection; Code distance; Codegeneration; Computing education; Distance algorithm; Hier-archical clustering; Hierarchical Clustering; Novice programmer; Plagiarism; Hierarchical clustering},
