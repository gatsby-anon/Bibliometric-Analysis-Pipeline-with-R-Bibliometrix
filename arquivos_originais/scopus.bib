@ARTICLE{Jo2025,
	author = {Jo, Wooyong and Soderberg, Elliott},
	title = {Investments in human talent in the Age of AI: the impact of ChatGPT on search volume for coding education platforms},
	year = {2025},
	journal = {Applied Economics Letters},
	pages = {},
	doi = {10.1080/13504851.2025.2486725},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002079447&doi=10.1080%2F13504851.2025.2486725&partnerID=40&md5=f6d557c2d3fd70e91d10e4ed3134518f},
	affiliations = {Mitch Daniels School of Business, West Lafayette, United States},
	abstract = {This study examines the impact of Generative AI, specifically ChatGPT, on the demand for coding education platforms as reflected in search volume. Using two years of Google Trends data, we analyse how the introduction of ChatGPT in November 2022 influenced search interest in major code learning platforms. Our findings reveal a significant decline in search volume following ChatGPT’s launch, suggesting that Generative AI may reduce interest in traditional coding education. However, platforms with strong brand equity–measured by their pre-ChatGPT popularity–experienced a smaller decline, indicating that brand strength helps mitigate AI-driven disruptions. This suggests that platforms can sustain relevance by investing in brand-building strategies, fostering engaged learning communities, and integrating AI-powered tools in a complementary manner. Our results remain robust against alternative explanations, such as seasonal trends in coding education or unobserved platform-specific time trends. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {brand equity; digital education; Generative AI; human talent},
	correspondence_address = {W. Jo; Daniels School of Business, Purdue University, West Lafayette, United States; email: wooyong@purdue.edu},
	publisher = {Routledge},
	issn = {14664291; 13504851},
	language = {English},
	abbrev_source_title = {Appl. Econ. Lett.},
	type = {Article},
	publication_stage = {aip},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Bronze Open Access}
}

