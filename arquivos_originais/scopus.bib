	title = {Automated Programming Exercise Generation in the Era of Large Language Models},
	year = {2024},
	journal = {Software Engineering Education Conference, Proceedings},
	pages = {},
	doi = {10.1109/CSEET62301.2024.10662984},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85204471285&doi=10.1109%2FCSEET62301.2024.10662984&partnerID=40&md5=d41916911bafa10ebec70b1485bab462},
	affiliations = {Universität Stuttgart, Institute of Software Engineering, Stuttgart, Germany},
	abstract = {Lecturers are increasingly attempting to use large language models (LLMs) to simplify and make the creation of exercises for students more efficient. Efforts are also being made to automate the exercise creation process in software engineering (SE) education. This study explores the use of advanced LLMs, including GPT-4 and LaMDA, for automated programming exercise creation in higher education and compares the results with related work using GPT-3.5-turbo. Utilizing applications such as ChatGPT, Bing AI Chat, and Google Bard, we identify LLMs capable of initiating different exercise designs. However, manual refinement is crucial for accuracy. Common error patterns across LLMs highlight challenges in complex programming concepts, while specific strengths in various topics showcase model distinctions. This research underscores LLMs' value in exercise generation, emphasizing the critical role of human supervision in refining these processes. Our concise insights cater to educators, practitioners, and other researchers seeking to enhance SE education through LLM applications. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {AI-Generated Exercises; Large Language Models; Programming Exercises; Software Engineering Education},
	keywords = {Ada (programming language); Artificial intelligence; Automatic programming; Teaching; AI-generated exercise; Automated programming; Creation process; Exercise generations; High educations; Language model; Large language model; Programming exercise; Related works; Software engineering education; Engineering education},
