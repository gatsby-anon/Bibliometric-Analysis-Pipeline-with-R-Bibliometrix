@CONFERENCE{Pereira Cipriano2025236,
	author = {Pereira Cipriano, Bruno and Alves, Pedro},
	title = {“ChatGPT Is Here to Help, not to Replace Anybody”: An Evaluation of Students' Opinions on Integrating ChatGPT in CS Courses},
	year = {2025},
	journal = {International Conference on Computer Supported Education, CSEDU - Proceedings},
	volume = {2},
	pages = {236 - 245},
	doi = {10.5220/0013212000003932},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105003739674&doi=10.5220%2F0013212000003932&partnerID=40&md5=7a02323a0fd6b4dfe563f98a0a43c1bc},
	affiliations = {Lusófona University, Campo GrandeLisboa, Portugal},
	abstract = {Large Language Models (LLMs) like OpenAI's GPT are capable of producing code based on textual descriptions, with remarkable efficacy. Such technology will have profound implications for computing education, raising concerns about cheating, excessive dependence, and a decline in computational thinking skills, among others. There has been extensive research on how teachers should handle this challenge but it is also important to understand how students feel about this paradigm shift. In this research, 52 first-year CS students were surveyed in order to assess their views on technologies with code-generation capabilities, both from academic and professional perspectives. Our findings indicate that while students generally favor the academic use of GPT, they don't over rely on it, only mildly asking for its help. Although most students benefit from GPT, some struggle to use it effectively, urging the need for specific GPT training. Opinions on GPT's impact on their professional lives vary, but there is a consensus on its importance in academic practice. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Gpt; Large Language Models; Learning to Program; Students Survey},
	keywords = {Computer hardware description languages; Curricula; Engineering education; High level languages; Personnel training; Report generators; Teaching; Computational thinkings; Computing education; Gpt; Language model; Large language model; Learning to program; Student surveys; Teachers'; Textual description; Thinking skills; Students},
