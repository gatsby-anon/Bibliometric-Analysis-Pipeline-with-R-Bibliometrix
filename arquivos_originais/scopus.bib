	author = {Prather, James and Reeves, Brent N. and Denny, Paul C. and Becker, Brett A. and Leinonen, Juho and Luxton-Reilly, Andrew and Powell, Garrett B. and Finnie-Ansley, James and Santos, Eddie Antonio},
	title = {“It’s Weird That it Knows What I Want”: Usability and Interactions with Copilot for Novice Programmers},
