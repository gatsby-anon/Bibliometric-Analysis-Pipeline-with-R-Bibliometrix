@ARTICLE{Shang20241941,
	author = {Shang, Shanshan and Sen, Geng},
	title = {Empowering learners with AI-generated content for programming learning and computational thinking: The lens of extended effective use theory},
	year = {2024},
	journal = {Journal of Computer Assisted Learning},
	volume = {40},
