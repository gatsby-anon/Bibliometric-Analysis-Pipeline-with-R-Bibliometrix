	title = {AI-AFACT: Designing AI-Assisted Formative Assessment of Coding Tasks in Web Development Education},
	year = {2025},
	journal = {International Conference on Computer Supported Education, CSEDU - Proceedings},
	volume = {2},
	pages = {379 - 386},
	doi = {10.5220/0013430500003932},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105003740662&doi=10.5220%2F0013430500003932&partnerID=40&md5=f2aee6fed20e0a0800cb67b82ac3fadb},
	affiliations = {Hochschule Burgenland, Eisenstadt, Austria; Universität Wien, Vienna, Austria; Universität Wien, Faculty of Computer Science, Vienna, Austria},
	abstract = {Large Language Models (LLMs) are finding their way into computer science education. In particular, their natural language capabilities allow them to be used for formative assessment of student work, with the goal of reducing teacher time. However, initial research shows that there are still weaknesses in their use. To overcome this, this paper presents a design for an assessment tool that combines an LLM with a human-in-the-loop approach to ensure high-quality feedback. The proposed system focuses on the assessment of student submissions in the field of web technologies, which can be evaluated in different ways, including the content of the submitted files and the graphical output. Therefore, the use of a multimodal LLM is being considered. The innovative approach of a continuous learning system could significantly improve the efficiency of the assessment process, benefiting both teachers and students. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial Intelligence; Computing Education; Design Science Research; Formative Assessment; Large Language Model; Web Development Education},
	keywords = {Codes (symbols); Curricula; Electronic design automation; Engineering education; Learning systems; Personnel training; Students; Supervised learning; Computer Science Education; Computing education; Design-science researches; Formative assessment; Language model; Large language model; Natural languages; Teachers'; Web development; Web development education; Teaching},
