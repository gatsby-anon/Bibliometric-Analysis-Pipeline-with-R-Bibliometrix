@CONFERENCE{Sah2024,
	author = {Sah, Chandan Kumar and Lian, Xiaoli and Islam, Muhammad Mirajul and Islam, Md Kamrul},
	title = {Navigating the AI Frontier: A Critical Literature Review on Integrating Artificial Intelligence into Software Engineering Education},
	year = {2024},
	journal = {Software Engineering Education Conference, Proceedings},
	pages = {},
	doi = {10.1109/CSEET62301.2024.10663054},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85204483674&doi=10.1109%2FCSEET62301.2024.10663054&partnerID=40&md5=ec63fde21ee4504ba9dbb2c81c158f19},
	affiliations = {Beihang University, Beijing, China; Westcliff University, College of Technology and Engineering, Irvine, United States; Université Libre de Bruxelles, Brussels, Belgium},
	abstract = {The swift development of Artificial Intelligence (AI), namely the introduction of Large Language Models (LLMs), is drastically altering various industries and necessitating a major change in the way software engineering is taught. To equip upcoming software engineers with the knowledge and abilities to function in this AI-powered environment, curriculum and pedagogical techniques must be critically reevaluated. To better understand the integration of AI and LLMs into software engineering education, this study gives a thorough and critical analysis of the literature, looking at existing models, pedagogical frameworks, and enduring issues. We explore various approaches utilized by educational establishments, including as specialized AI and LLM courses, incorporating modules into pre-existing curricula, and utilizing open-source LLM materials. Our analysis, which is based on case studies and research data, thoroughly assesses how well these strategies enable software engineers to comprehend, make use of, and ethically create AI and LLMs. Key obstacles to the successful integration of AI and LLM are also identified by our analysis, including the inexperienced status of LLM educators, resource limitations, potential biases in AI and LLM algorithms, and insufficient instructor knowledge. Building on these discoveries, we provide solid answers to these problems and suggest interesting avenues for further study to improve the integration of AI and LLM. In the end, this study advocates for a multimodal strategy to get future software engineers ready for the impending AI and LLM future and secure their place in this quickly changing field. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {AI Bias; artificial intelligence (AI); curriculum integration; Instructor Skill; large language models (LLMs); LLM Bias; Open-Source LLM Resources; Pedagogical frame-works; problems and solutions; Resource Limitations; software engineering education; successful strategies},
	keywords = {Artificial intelligence; Computer aided software engineering; Engineering education; Open source software; Problem oriented languages; Teaching; Artificial intelligence bias; Curriculum integration; Frame-work; Instructor skill; Language model; Large language model; Large language model bias; Model bias; Open-source; Open-source large language model resource; Pedagogical frame-work; Problems and Solutions; Resource limitations; Software engineering education; Successful strategy; Curricula},
	editor = {Bollin, A. and Bosnic, I. and Brings, J. and Daun, M. and Manjunath, M.},
