@CONFERENCE{Hyrynsalmi2025783,
	author = {Hyrynsalmi, Sonja M. and Tuape, Micheal and Knutas, Antti},
	title = {"Person is a person, a tool is a tool" - ChatGPT’s Role in Student Help-Seeking Behavior and Peer Support},
	year = {2025},
	journal = {Proceedings of the ACM SIGSOFT Symposium on the Foundations of Software Engineering},
	pages = {783 - 788},
	doi = {10.1145/3696630.3727235},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013968633&doi=10.1145%2F3696630.3727235&partnerID=40&md5=730e50c2c47a51ace2e2cde9635d45c5},
	affiliations = {LUT University, Lappeenranta, Finland; LUT University, Lappeenranta, Finland},
	abstract = {Generative Artificial Intelligence (GenAI) tools, such as ChatGPT, are reshaping higher education. In research, a lot of attention has been given to concerns like academic integrity and how to integrate AI into learning and teaching. However, little is known about how these tools impact student help-seeking patterns and peer interactions. This short paper investigates GenAI tools, help-seeking preferences and the importance of peer support among first-year software engineering students (n=94). Our responses show that 50% of the students use GenAI tools as the primary source of help-seeking, and 43% report that using ChatGPT reduces their need to interact with peers. However, students generally recognize the importance of social interaction and peer support for their learning. We use these duality findings to extend previous recommendations for integrating generative AI in education by providing new recommendations on how educators can support help-seeking and peer support in the age of GenAI. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Help-seeking; informal learning; peer-support; software engineering education; teaching},
	keywords = {Artificial intelligence; Computer supported cooperative work; Distributed computer systems; Education computing; Engineering education; Software engineering; Students; Academic integrity; Artificial intelligence tools; First year; Help seeking; High educations; Informal learning; Learning and teachings; Peer interactions; Peer support; Software engineering education; Teaching},
	correspondence_address = {S.M. Hyrynsalmi; LUT University, Lahti, Finland; email: sonja.hyrynsalmi@lut.fi},
	editor = {Li, J.},
