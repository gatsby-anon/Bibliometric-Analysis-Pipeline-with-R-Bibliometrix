}

@CONFERENCE{Styve2024,
	author = {Styve, Arne G. and Virkki, Outi Tuulia and Naeem, Usman},
	title = {Developing Critical Thinking Practices Interwoven with Generative AI Usage in an Introductory Programming Course},
	year = {2024},
	journal = {IEEE Global Engineering Education Conference, EDUCON},
	pages = {},
	doi = {10.1109/EDUCON60312.2024.10578746},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199061601&doi=10.1109%2FEDUCON60312.2024.10578746&partnerID=40&md5=7df7423e99490dbcd3ca440624b322e0},
	affiliations = {Norges Teknisk-Naturvitenskapelige Universitet, Department of ICT and Natural Sciences, Trondheim, Norway; Haaga-Helia University Of Applied Sciences, Information Technology Degree Programme, Helsinki, Finland; Queen Mary University of London, London, United Kingdom},
	abstract = {Software development has evolved significantly. In the past, developers were required to have comprehensive understanding of programming languages, algorithms, and computer architecture. However, with the emergence of the Internet, software libraries, frameworks, and forums became widely available, which utilize reusable software components that can reduce development time and costs. The advent of Generative Artificial Intelligence (AI) tools, such as ChatGPT, GitHub Copilot, and Amazon CodeWhisperer, has further enhanced the developer's toolkit, as these tools can be used for a wide variety of tasks such as code generation, documentation, commenting and reviewing. As programming is often slow and requires trial and error, novice programmers can be tempted to apply the first solution found on the Internet or proposed by an AI tool without much critical reflection or notion of responsibility. Hence, the advances of AI have raised both excitement and concerns among Information Technology (IT)/Computer Science (CS) students and educators. Yet, AI tools are here to stay, and students must learn to use them responsibly. The aim of this paper is to investigate how to design learning activities that introduce Generative AI tools (GitHub Copilot and ChatGPT) for programming while promoting critical thinking practices among students in an introductory programming course in the first semester. Students' opinions and customs were surveyed before and after the AI-based programming assignment. The results indicate that students' awareness of the possibilities and limitations of AI, as well as practices of critical thinking in programming increased. This is encouraging as critical thinking is an integral part of best programming practices. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Critical Thinking; CS1; Generative AI; Higher Education},
	keywords = {Computer architecture; Computer software reusability; Curricula; Education computing; Software design; Artificial intelligence tools; Critical thinking; Development costs; Development time; Generative artificial intelligence; High educations; Internet software; Introductory programming course; Reusable software components; Software libraries; Students},
	publisher = {IEEE Computer Society},
	issn = {21659559; 21659567},
	isbn = {9781467386333; 9781479931910; 9781538629574; 9781479919086; 9781467361101; 9798350394023; 9781728184784; 9781509054671; 9781538695067; 9781728109305},
	language = {English},
