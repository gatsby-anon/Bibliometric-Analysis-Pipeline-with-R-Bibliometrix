@CONFERENCE{Deriba2023,
	author = {Deriba, Fitsum Gizachew and Sanusi, Ismaila Temitayo and Sunday, Amos Oyelere},
	title = {Enhancing Computer Programming Education using ChatGPT: A Mini Review},
	year = {2023},
	pages = {},
	doi = {10.1145/3631802.3631848},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85185530072&doi=10.1145%2F3631802.3631848&partnerID=40&md5=c495c3f3a9082ca884bb595680b8406f},
	affiliations = {Itä-Suomen yliopisto, Kuopio, Finland},
	abstract = {This paper aims to provide insights into how ChatGPT enhances computer programming education by synthesizing existing studies using rapid review. We analysed 13 articles published in 2023, where studies focused on different aspects of basic programming education. The results indicate that 21% of these studies demonstrate that ChatGPT served as a tool for code explanation and handling complex topics. However, 36% show that ChatGPT had difficulty answering non-text-based and code-related questions, revealing reliability and accuracy issues with these tools. Another 36% of the studies showed that blindly over-reliance on ChatGPT affected critical thinking, student creativity, and problem-solving skills in programming education. 46% of the studies indicated the need to provide clear guidelines and employ plagiarism-detection tools to instruct students effectively. We suggest that educators should adopt diverse approaches to integrating ChatGPT as an educational tool while highlighting ethical considerations and model limitations. © 2024 Elsevier B.V., All rights reserved.},
	keywords = {Education computing; Students; Critical thinking; Detection tools; Educational tools; Ethical considerations; Over reliance; Plagiarism detection; Problem solving skills; Programming education; Computer programming},
	correspondence_address = {F.G. Deriba; University of Eastern Finland, Joensuu, Finland; email: fgizache@uef.fi; I.T. Sanusi; University of Eastern Finland, Joensuu, Finland; email: ismaila.sanusi@uef.fi; A.O. Sunday; University of Eastern Finland, Joensuu, Finland; email: amossun@uef.fi},
