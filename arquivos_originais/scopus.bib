@CONFERENCE{Menolli2024563,
	author = {Menolli, André Luís Andrade and Strik, Bruno and Rodrigues, Luiz Antonio Lima},
	title = {Teaching Refactoring to Improve Code Quality with ChatGPT: An Experience Report in Undergraduate Lessons},
	year = {2024},
	pages = {563 - 574},
	doi = {10.1145/3701625.3701681},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216269660&doi=10.1145%2F3701625.3701681&partnerID=40&md5=21dcaf52fac1b46bec3b0ccb16b64b51},
	affiliations = {Universidade Estadual do Norte do Paraná, Jacarezinho, Brazil; Universidade Estadual de Londrina, Londrina, Brazil; Universidade Estadual de Londrina, Londrina, Brazil; Universidade Federal da Paraíba, Instituto de Computação, Joao Pessoa, Brazil},
	abstract = {Refactoring presents a complex computational challenge, and its learning is intricate, requiring a solid foundation in computational thinking, programming and object-oriented concepts. Moreover, making students realize the importance and benefits of refactoring is also challenging. To address this complexity, we introduce a refactoring teaching method based on Generative Artificial Intelligence (GAI), incorporating single-loop and double-loop learning principles, focusing on fostering deeper and critical learning. We used ChatGPT, a GAI-based tool, and conducted an eight-week mixed-methods study involving 23 computer science undergraduate students. The study involved applying four distinct projects extracted from GitHub, where participants were tasked with identifying code smells and performing the necessary refactoring to improve code quality. The primary focus was on identifying both the positive and negative aspects of the method, as well as delineating the computational thinking characteristics developed during the process. The results indicate that the use of ChatGPT facilitated the learning of refactoring, contributing to the development of numerous computational thinking skills, especially problem formulation, decomposition, and abstraction. Thus, this paper contributes a GAI-based teaching method along with evidence on how it helps students develop refactoring skills. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {ChatGPT; Computational Thinking; Generative Artificial Intelligence; Higher Education; Refactory; Teaching},
	keywords = {Adversarial machine learning; Contrastive Learning; Students; Teaching; ChatGPT; Code quality; Computational challenges; Computational thinkings; Experience report; Generative artificial intelligence; High educations; Refactorings; Refactory; Teaching methods; Object oriented programming},
	publisher = {Association for Computing Machinery},
	isbn = {9798400717772},
	language = {English},
	abbrev_source_title = {ACM Int. Conf. Proc. Ser.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Sampaio2024624,
	author = {Sampaio, Savio Sousa and Meireles, Maria Alcimar Costa and Lima, Marcia Sampaio and Pessoa, Marcela Savia and Rodrigues, Eriky and Conte, Tayana Uchôa},
	title = {Exploring the Use of Large Language Models in Requirements Engineering Education: An Experience Report with ChatGPT 3.5},
	year = {2024},
	pages = {624 - 634},
	doi = {10.1145/3701625.3701687},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216185526&doi=10.1145%2F3701625.3701687&partnerID=40&md5=45443789315973ad63173333b7248501},
	affiliations = {Universidade Federal do Amazonas, Manaus, Brazil; Universidade do Estado do Amazonas, Manaus, Brazil},
	abstract = {Large Language Models (LLMs) are becoming common in educational settings. This trend presents a challenge for teachers, who must focus on teaching the proper usage of LLMs. In the context of Software Engineering (SE), ChatGPT can support various software development tasks. This work reports an experience with students using ChatGPT 3.5 to support the Requirements Engineering (RE) phase. We conducted a two-phase study with 42 students. First, the students elicited requirements for systems using RE techniques. Then, the students used ChatGPT 3.5 to generate requirements for the same systems. Finally, they compared both sets of requirements based on equivalence, innovation, and relevance. On average, 65.26% of the requirements generated by ChatGPT were considered equivalents to the requirements the students had elicited. However, students reported that ChatGPT generates broad and non-specific requirements. Students also reported that ChatGPT 3.5 can foster the requirements elicitation, but it is necessary to establish well-defined prompts for generating requirements. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {ChatGPT 3.5; Requirement Elicitation; Software engineering education},
	keywords = {Computer aided software engineering; Engineering education; Software design; Students; Teaching; ChatGPT 3.5; Development tasks; Educational settings; Engineering phase; Experience report; Language model; Requirement engineering; Requirements elicitation; Software engineering education; Teachers'; Requirements engineering},
	correspondence_address = {S.S. Sampaio; IComp - USES Universidade Federal do Amazonas, Manaus, AM, Brazil; email: savio.sampaio@icomp.ufam.edu.br; M.S. Lima; Núcleo de Computação Universidade do Estado do Amazonas, Manaus, AM, Brazil; email: msllima@uea.edu.br; T.U. Conte; IComp - USES Universidade Federal do Amazonas, Manaus, AM, Brazil; email: tayana@icomp.ufam.edu.br},
