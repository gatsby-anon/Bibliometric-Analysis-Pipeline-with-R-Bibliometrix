@CONFERENCE{Skripchuk20241818,
	author = {Skripchuk, James and Bacher, John Thomas and Shi, Yang and Tran, Keith and Price, Thomas W.},
	title = {Novices' Perceptions of Web-Search and AI for Programming},
	year = {2024},
