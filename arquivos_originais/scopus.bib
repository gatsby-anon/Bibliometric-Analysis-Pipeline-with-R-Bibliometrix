@CONFERENCE{Havare2025171,
	author = {Havare, Jayant and Apte, Varsha and Maharajan, Kaushikraj and Samudrala, Nithin Chandra Gupta and Ramakrishnan, Ganesh and Tamilselvam, Srikanth G. and Vavilapalli, Sainath},
	title = {Ai-Based Automated Grading of Source Code of Introductory Programming Assignments},
	year = {2025},
	journal = {IEEE International Conference on Program Comprehension},
	pages = {171 - 181},
	doi = {10.1109/ICPC66645.2025.00025},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105009076270&doi=10.1109%2FICPC66645.2025.00025&partnerID=40&md5=e862cbcf52c23041280e9352ad08fc0b},
	affiliations = {Indian Institute of Technology Bombay, Mumbai, India; IBM Research, Yorktown Heights, United States},
	abstract = {In a typical introductory programming course, grading of student submitted programs is often done manually by examining the source code prior to assigning the final grade for reasons such as checking for compliance to some criteria (e.g. 'Use iteration, not recursion', or 'do not use additional arrays'), or for allotting partial marks. A rubric is often used by graders to grade according such criteria. However, manual grading of source code can be labor-intensive and impractical for large-scale online courses. Therefore, in this paper, we propose techniques based on Large Language Models (LLM) for code to automatically grade student programs according to instructor-specified rubrics. Leveraging a dataset of 27966 datapoints that we created, we study a total of 44 combinations of different open source LLMs and methodologies including Zero-Shot prompting, Few-Shot prompting, Supervised Fine Tuning, QLoRA, Direct Preference Optimization (DPO), code scrambling and code augmentation. To our knowledge, we are the first to address the generalized source code grading problem and to propose a solution with promising results. We find that among the models we studied, while Codestral 22B achieves a high micro-accuracy of 85% without any fine-tuning, Qwen-2.5-Coder-7B-Instruct with DPO fine-tuning achieves the same micro-accuracy with only 35 % of the GPU memory usage and 10 % of the inference time taken by Codestral 22B. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Instruction finetuning; Prompt Engineering},
	keywords = {Curricula; Open source software; Open systems; Automated grading; Fine tuning; Instruction finetuning; Introductory programming; Introductory programming course; Preference optimizations; Programming assignments; Prompt engineering; Recursions; Source codes; Codes (symbols)},
	publisher = {IEEE Computer Society},
	issn = {26437147; 26437171},
	isbn = {9781450392983; 9798400705861; 9798331502232},
	language = {English},
	abbrev_source_title = {IEEE Int. Conf. Program Comprehension},
	type = {Conference paper},
