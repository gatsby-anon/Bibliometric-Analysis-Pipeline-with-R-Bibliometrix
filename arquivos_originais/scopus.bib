	keywords = {Computer simulation languages; Curricula; Formal languages; Teaching; Chatgpt; Computer Science Education; Computing course; Formal definition; Language model; Large language model; Multiple choice; Open-ended response; Simple++; Theoretical computer science; Automata theory},
