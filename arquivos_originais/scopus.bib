	affiliations = {University of Danang, University of Science and Technology, Da Nang, Viet Nam},
	abstract = {The application of artificial intelligence (AI) technology, especially ChatGPT, is becoming a powerful tool in programming education. ChatGPT helps improve programming skills, supports answering questions, provides source code examples, and explains programming concepts. It is also a valuable resource for self-study and research. However, in Vietnam, the implementation and dissemination of ChatGPT in programming education still face many challenges. This study aims to identify the factors affecting the decision to use ChatGPT of 10th-grade students in programming learning, thereby finding the factor with the most substantial impact. To achieve the above goal, the authors conducted a quantitative survey with 845 10th-grade students at high schools in Da Nang City. The collected data were processed using SPSS 24 software and analyzed using Structural Equation Modeling (SEM), and the meaning of DTU (Decision to Use) was explained. The SEM analysis showed that four main factors–support tools, personal capacity, background knowledge, and learning environment–positively impacted students’ decision to use ChatGPT. Personal capacity was the most decisive factor. In contrast, the factor of ChatGPT’s usefulness did not have a statistically significant impact on this decision. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {artificial intelligence in education; ChatGPT; learning programming; programming learning methods; Vietnamese education},
	correspondence_address = {H. Van Tran; University of DaNang, University of Science and Education, DaNang, Viet Nam; email: tvhung@ued.udn.vn},
