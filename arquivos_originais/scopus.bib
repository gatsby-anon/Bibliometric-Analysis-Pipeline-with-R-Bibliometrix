@ARTICLE{Aviv2024207,
	author = {Aviv, Itzhak and Leiba, Moshe and Rika, Havana and Shani, Yogev},
	title = {The Impact of ChatGPT on Students’ Learning Programming Languages},
	year = {2024},
	journal = {Lecture Notes in Computer Science},
	volume = {14724 LNCS},
	pages = {207 - 219},
	doi = {10.1007/978-3-031-61691-4_14},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85196858578&doi=10.1007%2F978-3-031-61691-4_14&partnerID=40&md5=b77a918fca7eeed4768c1a1753bf64a0},
	affiliations = {Academic College of Tel-Aviv - Yaffo, Tel Aviv, Israel},
	abstract = {This study addresses the gap in understanding the impact of ChatGPT, on Java programming language education. We examined ChatGPT's afinity on undergraduate Information Systems students learning Java through a mixed-methods approach. Quantitatively, we assessed constructs like ChatGPT Prompting Skills, Trust, Objective Values, and their relationship with student satisfaction, revealing mixed effectiveness. Qualitatively, we explored students’ perspectives, uncovering insights into ChatGPT's role in coding support and the nuances of its educational impact. Our findings indicate that while ChatGPT can enhance certain aspects of learning, its effectiveness varies with context and task complexity. Key positive findings from the regression analysis indicated that ChatGPT's prompting skills positively impacted both Objective and Subjective Values, suggesting a significant role in enhancing students’ understanding and engagement with programming concepts. This positive influence extends to the relationship between Subjective Value and Student Satisfaction, highlighting the importance of students’ subjective experiences in their overall satisfaction with learning programming languages. The study contributes to the evolving discourse on AI in education, highlighting the need to integrate LLMs carefully in educational settings. It underscores the importance of aligning AI tools with specific learning objectives and outlines implications for educators and AI developers in optimizing these tools for educational purposes. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {ChatGPT; Large Language Models; LLM; software development},
	keywords = {Education computing; Java programming language; Learning systems; Object oriented programming; Regression analysis; Software design; ChatGPT; Language model; Large language model; Learning programming; LLM; Mixed method; Programming language education; Student learning; Student perspectives; Student satisfaction; Students},
	correspondence_address = {I. Aviv; The Academic College of Tel Aviv–Yaffo, Tel Aviv–Yaffo, Israel; email: itzhakav@mta.ac.il},
