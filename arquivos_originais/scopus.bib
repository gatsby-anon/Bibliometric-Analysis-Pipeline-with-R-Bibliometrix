@CONFERENCE{Lund2025976,
	author = {Lund, Camilla Kielland and Stabell, Idunn and Stray, Viktoria Gulliksen and Lindsjørn, Yngve},
	title = {Teamwork Quality in Agile Capstone Courses: Insights from 790 Software Engineering Students},
	year = {2025},
	journal = {Proceedings of the ACM SIGSOFT Symposium on the Foundations of Software Engineering},
	pages = {976 - 986},
	doi = {10.1145/3696630.3727254},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013957603&doi=10.1145%2F3696630.3727254&partnerID=40&md5=16c5e454eaac98e643f268b978dfa25f},
	affiliations = {Universitetet i Oslo, Oslo, Norway},
	abstract = {Teamwork quality (TWQ), team members’ success, and team performance are critical components of effective collaboration in modern software development. As capstone courses in software engineering aim to prepare students for industry practices, understanding the factors that influence team dynamics is essential. This study investigates the relationship between team ambition levels and TWQ, team members’ success, and team performance in an agile capstone course. Our study involves 133 student teams comprising 790 students across three consecutive years (2022-2024). Data collection included 1,122 responses from pre- and post-surveys. In all three years, students were grouped into teams based on ambition levels. In 2024, the course structure was changed to place less emphasis on written project reports due to the widespread adoption of AI tools like ChatGPT. The results show that ambition levels were positively correlated with TWQ, team members’ success, and team performance in 2022 and 2023, with higher ambition levels generally associated with improved collaboration and outcomes. However, in 2024, there were reduced disparities between lower and higher-ambition teams, enabling more equitable success across all teams. This study highlights that while ambition levels play a role in influencing teamwork and success, structured interventions that prioritize collaboration and inclusivity have a more substantial impact. These findings suggest that moving away from ambition-based team formation and focusing on fostering high-quality teamwork processes can better prepare students for real-world agile environments. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Agile Software Development; Ambition; Capstone Course; Collaboration; Software Engineering Education; Team Dynamics; Teamwork},
	keywords = {Agile manufacturing systems; Curricula; Education computing; Engineering education; Groupware; Software design; Software quality; Agile software development; Ambition; Capstone course; Collaboration; Software engineering education; Team dynamics; Team members; Team performance; Teamwork; Teamwork qualities; Students},
	correspondence_address = {V. Stray; University of Oslo, Oslo, Norway; email: stray@uio.no},
