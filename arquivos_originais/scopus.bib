	year = {2023},
	journal = {Annual Conference on Innovation and Technology in Computer Science Education, ITiCSE},
	volume = {2},
	pages = {561 - 562},
	doi = {10.1145/3587103.3594206},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85166290735&doi=10.1145%2F3587103.3594206&partnerID=40&md5=507d2fbbb3ca44725925988d1207dd30},
	affiliations = {Abilene Christian University, Abilene, United States; The University of Auckland, Auckland, New Zealand; University College Dublin, Dublin, Ireland; Princess Sumaya University, Amman, Jordan; Aarhus Universitet, Aarhus, Denmark; University of Toronto, Toronto, Canada; Universiteit Utrecht, Utrecht, Netherlands; Deutsches Institut für Internationale Pädagogische Forschung, Frankfurt am Main, Germany; TU Wien, Vienna, Austria; Temple University, Philadelphia, United States; University of Toronto, Toronto, Canada; University of Virginia, Charlottesville, United States; Carnegie Mellon University, Pittsburgh, United States},
	abstract = {The recent advent of highly accurate and scalable large language models (LLMs) has taken the world by storm. From art to essays to computer code, LLMs are producing novel content that until recently was thought only humans could produce. Recent work in computing education has sought to understand the capabilities of LLMs for solving tasks such as writing code, explaining code, creating novel coding assignments, interpreting programming error messages, and more. However, these technologies continue to evolve at an astonishing rate leaving educators little time to adapt. This working group seeks to document the state-of-the-art for code generation LLMs, detail current opportunities and challenges related to their use, and present actionable approaches to integrating them into computing curricula. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {AI; artificial intelligence; code generation; codex; computer programming; copilot; CS1; GitHub; GPT; large language models; LLM; novice programming; openAI; pedagogical practices},
	keywords = {Arts computing; Computational linguistics; Curricula; Codegeneration; Codex; Copilot; Github; GPT; Language model; Large language model; Novice programming; Openai; Pedagogical practices; Computer programming},
