@ARTICLE{Lai2025,
	author = {Lai, Chienhung and Lin, Chengyueh},
	title = {Analysis of Learning Behaviors and Outcomes for Students with Different Knowledge Levels: A Case Study of Intelligent Tutoring System for Coding and Learning (ITS-CAL)},
	year = {2025},
	journal = {Applied Sciences (Switzerland)},
