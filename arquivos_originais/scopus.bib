@CONFERENCE{Chang2025372,
	author = {Chang, Chiin and Choi, Wanchong and Choi, Iek Chong},
	title = {Challenges and Limitations of Using Artificial Intelligence Generated Content (AIGC) with ChatGPT in Programming Curriculum: A Systematic Literature Review},
	year = {2025},
	pages = {372 - 378},
	doi = {10.1145/3719384.3719439},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105011735056&doi=10.1145%2F3719384.3719439&partnerID=40&md5=41ee0fd4db3494b21bc26e4b48a049d0},
	affiliations = {Golden Gate University, Department of Psychology, San Francisco, United States; College of Computing, Chicago, United States; City University of Macau, School of Education, Taipa, Macao},
	abstract = {This systematic literature review examined the challenges and limitations of integrating Artificial Intelligence Generated Content (AIGC) tools into programming curricula. Following Kitchenham's framework, a comprehensive search was conducted across ACM Digital Library and Web of Science databases to select 22 relevant peer-reviewed papers. Key issues identified included increased plagiarism risk due to AI-generated unique code, accuracy and reliability concerns of AI outputs, privacy and data security risks, curriculum changes to incorporate prompt engineering and critical thinking, and challenges in traditional assessment methods. Additionally, the review highlighted the potential over-reliance on AI tools, which could hinder the development of fundamental programming skills. Implementation challenges and inadequate training for educators further complicate the integration process. Addressing these challenges is crucial for leveraging the benefits of AIGC tools while maintaining academic integrity and enhancing learning outcomes in programming education. Future research should focus on developing strategies to mitigate these issues and ensure the responsible use of AI in education. © 2025 Elsevier B.V., All rights reserved.},
