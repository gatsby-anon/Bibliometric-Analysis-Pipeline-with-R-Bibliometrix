@CONFERENCE{Choi202555,
	author = {Choi, Wanchong and Choi, Iek Chong and Chang, Chiin and Lam, Laichu},
	title = {Comparison of Claude (Sonnet and Opus) and ChatGPT (GPT-4, GPT-4o, GPT-o1) in Analyzing Educational Image-Based Questions from Block-Based Programming Assessments},
	year = {2025},
	pages = {55 - 60},
	doi = {10.1109/ICIET66371.2025.11046263},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010698574&doi=10.1109%2FICIET66371.2025.11046263&partnerID=40&md5=c854b42bdb4b7bde7cadfa59b0c90f67},
	affiliations = {Macao Polytechnic University, Department of Computer Science, Macau, Macao; City University of Macau, School of Education, Taipa, Macao; Golden Gate University, Department of Psychology, San Francisco, United States; Steve Sanghi College of Engineering, Computing and Cyber Systems, Flagstaff, United States},
	abstract = {This study presented a novel application of OpenAI's GPT-o1 model for analyzing educational image-based questions derived from block-based programming assessments, contributing to the first systematic exploration of this advanced AI model in this field. We evaluated GPT-o1 alongside other state-of-the-art models, including GPT-4, GPT-4o, GPT-4o mini, Claude3.5 Sonnet, and Claude-3 Opus, to assess their accuracy in solving multiple-choice and fill-in-the-blank questions from a standardized block-based programming test. Our findings demonstrated that GPT-o1 significantly outperformed other models, achieving an accuracy of 80 %, which we attributed to its enhanced image analysis capabilities. Comparative analyses revealed GPT-01's superior performance in interpreting and responding to visual prompts, particularly in tasks requiring logical reasoning and computational thinking. Furthermore, the Pearson correlation test highlighted significant relationships between GPT-o1 and GPT-4o. Our contributions highlighted the potential applications of advanced chatbots in block-based programming education. These technologies can serve as personalized learning tutors to guide students in understanding and solving block-based programming tasks independently. Additionally, they can assist educators in automating the grading process and generating tailored programming exercises, thus improving teaching efficiency. © 2025 Elsevier B.V., All rights reserved.},
