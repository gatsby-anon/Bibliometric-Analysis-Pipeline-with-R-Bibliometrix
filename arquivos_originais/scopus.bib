	title = {CS1 with a Side of AI: Teaching Software Verification for Secure Code in the Era of Generative AI},
	year = {2024},
	volume = {1},
	pages = {345 - 351},
	doi = {10.1145/3626252.3630817},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85189322137&doi=10.1145%2F3626252.3630817&partnerID=40&md5=e1fe34ed5cc2c2719a950fb00fc36031},
	affiliations = {The University of Texas at San Antonio, San Antonio, United States; State University of New York Albany, Albany, United States},
	abstract = {As AI-generated code promises to become an increasingly relied upon tool for software developers, there is a temptation to call for significant changes to early computer science curricula. A move from syntax-focused topics in CS1 toward abstraction and high-level application design seems motivated by the new large language models (LLMs) recently made available. In this position paper however, we advocate for an approach more informed by the AI itself - teaching early CS learners not only how to use the tools but also how to better understand them. Novice programmers leveraging AI-code-generation without proper understanding of syntax or logic can create "black box"code with significant security vulnerabilities. We outline methods for integrating basic AI knowledge and traditional software verification steps into CS1 along with LLMs, which will better prepare students for software development in professional settings. © 2024 Elsevier B.V., All rights reserved.},
