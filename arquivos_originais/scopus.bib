	author = {Abouelenein, Yousri Attia Mohamed and Ghazala, Ayat Fawzy Ahmed and Mahdy, Eman Mohamed and Khalaf, Mohammed H.R.},
	title = {The R5E pattern: can artificial intelligence enhance programming skills development?},
	year = {2025},
