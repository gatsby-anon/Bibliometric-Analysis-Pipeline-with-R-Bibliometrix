@ARTICLE{Doyle2025,
	author = {Doyle, Aidan and Sridhar, Pragnya and Agarwal, Arav and Šavelka, Jaromír and Sakr, Majd F.},
	title = {A comparative study of AI-generated and human-crafted learning objectives in computing education},
	year = {2025},
