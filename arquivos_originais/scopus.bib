@CONFERENCE{Troussas2024194,
	author = {Troussas, Christos and Papakostas, Christos and Krouska, Akrivi and Mylonas, Phivos and Sgouropoulou, Cleo E.},
	title = {Evaluating ChatGPT-driven Automated Test Generation for Personalized Programming Education},
	year = {2024},
