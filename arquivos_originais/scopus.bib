@CONFERENCE{Smith2024171,
	author = {Smith, David H. and Zilles, Craig B.},
	title = {Code Generation Based Grading: Evaluating an Auto-grading Mechanism for "Explain-in-Plain-English" Questions},
	year = {2024},
	journal = {Annual Conference on Innovation and Technology in Computer Science Education, ITiCSE},
	volume = {1},
	pages = {171 - 177},
	doi = {10.1145/3649217.3653582},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85198902919&doi=10.1145%2F3649217.3653582&partnerID=40&md5=092f526ddbf97d51e6fa6d27b69d35f2},
	affiliations = {University of Illinois Urbana-Champaign, Urbana, United States},
	abstract = {Comprehending and conveying the purpose of code is often cited as being a key learning objective within introductory programming courses. To address this objective, "Explain in Plain English'' questions, where students are shown a segment of code and asked to provide an abstract description of the code's purpose, have been adopted. However, given EiPE questions require a natural language response, they often require manual grading which is time-consuming for course staff and delays feedback for students. With the advent of large language models (LLMs) capable of generating code, responses to EiPE questions can be used to generate code segments, the correctness of which can then be easily verified using test cases. We refer to this approach as "Code Generation Based Grading'' (CGBG) and in this paper we explore its agreement with human graders using EiPE responses from past exams in an introductory programming course taught in Python. Overall, we find that all CGBG approaches achieve moderate agreement with human graders with the primary area of disagreement being its leniency with respect to low-level and line-by-line descriptions of code. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {auto-grading; eipe; gpt-4; large language models},
	keywords = {Computational linguistics; Education computing; Students; Auto-grading; Codegeneration; Delay feedback; Eipe; Gpt-4; Introductory programming course; Language model; Large language model; Learning objectives; Natural languages; Grading},
