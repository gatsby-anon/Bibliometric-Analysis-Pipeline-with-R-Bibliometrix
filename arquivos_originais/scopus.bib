@ARTICLE{Lee2025403,
	author = {Lee, William and Arroyo, Ivon M.},
	title = {Toward Extracting Computational Thinking Evidence with Large Language Models: Empowering K-12 Educators},
	year = {2025},
	journal = {Communications in Computer and Information Science},
	volume = {2590 CCIS},
